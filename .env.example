# GAMC API — configuración por entorno
# Copia este archivo a `.env` y completa los valores reales.

# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=4000

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────────
# Project Settings → Database → Connection string → "Session pooler" (puerto 5432,
# compatible con IPv4). Reemplaza [PROJECT-REF], [REGION] y [PASSWORD].
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── Seguridad / JWT ───────────────────────────────────────────────────────────
# Clave de firma de los JWT (≥32 chars). Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio_0123456789abcdef

# Vida de los tokens: acceso (min) y refresh (días)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Cookie "Secure": solo HTTPS. En local (http://localhost) déjalo en false.
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# ÚNICOS orígenes autorizados, separados por coma. NUNCA "*" en producción.
# El backend rechaza cualquier Origin que no esté en esta lista.
CORS_ORIGINS=http://localhost:3000

# ── Recuperación de contraseña (sin correo por ahora) ─────────────────────────
# true  → el endpoint /auth/recovery/request devuelve el código en la respuesta
#         (solo para desarrollo/local). En producción déjalo en false; cuando
#         exista dominio se conectará un mailer por infraestructura.
DEV_RETURN_RESET_CODE=true

# Duración del código de recuperación en minutos
RESET_CODE_MINUTES=10

# ── Logs (pino) ───────────────────────────────────────────────────────────────
# pretty en dev, json en producción
LOG_LEVEL=info