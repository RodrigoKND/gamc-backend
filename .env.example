# GAMC API — configuración por entorno
# Copia este archivo a `.env` y completa los valores reales.

# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=4000

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────────
# Project Settings → Database → Connection string → "Session pooler" (puerto 5432,
# compatible con IPv4). Reemplaza [PROJECT-REF], [REGION] y [PASSWORD].
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Usados por docker-compose.yml para levantar el contenedor de Postgres.
# Deben coincidir con el usuario/password/db de DATABASE_URL de arriba.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gamc_seguridad

# ── Seguridad / JWT ───────────────────────────────────────────────────────────
# Clave de firma de los JWT (≥32 chars, recomendado 48+ bytes de entropía real).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#             o: openssl rand -hex 48
#
# ⚠️ NUNCA copies un valor de ejemplo como si fuera el secreto real — genera uno
# nuevo por entorno (dev/staging/producción) y guárdalo en el gestor de secretos
# de la plataforma, nunca en un archivo commiteado. Debe coincidir EXACTAMENTE
# (carácter por carácter) con el JWT_SECRET del frontend
# (MockUps/DiseñoPrototipo/.env.local) — si no coinciden, el middleware del
# frontend rechaza toda sesión válida silenciosamente.
JWT_SECRET=

# Vida de los tokens: acceso (min) y refresh (días)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Cookie "Secure": solo HTTPS. En local (http://localhost) déjalo en false.
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# ÚNICOS orígenes autorizados, separados por coma. NUNCA "*" en producción.
# El backend rechaza cualquier Origin que no esté en esta lista.
CORS_ORIGINS=http://localhost:3000

# ── Recuperación de contraseña (sin correo por ahora) ─────────────────────────
# true  → el endpoint /auth/recovery/request devuelve el código en la respuesta
#         (solo para desarrollo/local). En producción déjalo en false; cuando
#         exista dominio se conectará un mailer por infraestructura.
DEV_RETURN_RESET_CODE=true

# Duración del código de recuperación en minutos
RESET_CODE_MINUTES=10

# ── Cloudflare R2 (fotos y videos de la app) ──────────────────────────────────
# Dashboard de Cloudflare → R2 → bucket con acceso público (dominio propio o
# r2.dev) + "Manage R2 API Tokens" (permiso Object Read & Write).
# Definir las cinco; si se dejan vacías, los archivos van a ./uploads (solo dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Logs (pino)───────────────────────────────────────────────────────────────
# pretty en dev, json en producción
LOG_LEVEL=info
# ── Rendimiento ──────────────────────────────────────────────────────────────
# Pool de Prisma (solo si DATABASE_URL no trae connection_limit/pool_timeout).
# En hosting compartido mantener bajo para no agotar max_connections.
DB_POOL_MAX=10
DB_POOL_TIMEOUT_S=20
# Coste de bcrypt para hashes nuevos (10-14). Los hashes viejos se migran solos
# en el siguiente login correcto.
BCRYPT_ROUNDS=10
# Caché (s) de los agregados del dashboard; 0 la desactiva.
DASHBOARD_CACHE_SECONDS=5
