// GAMC · Seguridad Ciudadana — ORM (Prisma 5)
//
// Espejo de `GAMC/database/schema.sql` (v2). Fuente de los tipos del cliente
// y de las operaciones de datos. NOTA:
//  · El DDL canónico (triggers, vistas, funciones, columnas GENERADAS y
//    partial indexes) vive en `prisma/migrations/0001_init/migration.sql`
//    (copia fiel del schema.sql). Prisma administra las tablas; lo demás
//    se aplica una sola vez al crear la BD.
//  · `user.nombre` y `guardia.nombre` son columnas GENERATED en la BD: por
//    eso se excluyen aquí y las capas de datos las calculan/leen vía raw.

generator client {
  provider = "prisma-client-js"
 binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------ enums

enum user_estado {
  activo
  inactivo
  suspendido
}

enum guardia_estado {
  pendiente_activacion
  activo
  inactivo
  suspendido
}

enum guardia_estado_operativo {
  fuera_de_servicio
  en_servicio
  emergencia
}

enum turno_estado {
  en_servicio
  finalizado
  anulado
}

enum patrulla_estado {
  asignada
  en_curso
  completada
  cancelada
}

enum hecho_estado {
  reportado
  en_revision
  cerrado
}

enum nivel_riesgo {
  bajo
  medio
  alto
  muy_alto
}

enum sujeto_auth {
  user
  guardia
}

enum evidencia_tipo {
  foto
  video
}

enum checkpoint_estado {
  realizado
  perdido
}

// ------------------------------------------------------ 2. catálogos

model Epi {
  id        String   @id @default(uuid())
  codigo    String   @unique
  nombre    String
  poligono  Json?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Catálogo v2 (migración 0006, inventario oficial de 6 EPIs).
  numero        Int?    @db.SmallInt
  nombreOficial String? @map("nombre_oficial")
  color         String?
  sedeLat       Float?  @map("sede_lat")
  sedeLng       Float?  @map("sede_lng")
  sedeDireccion String? @map("sede_direccion")
  telefonos     Json?

  territorios       EpiTerritorio[]
  modulos           ModuloPolicial[]
  guardias          Guardia[]
  users             User[]
  rutas             RutaPlantilla[]
  patrullas         Patrulla[]
  hechoes           Hecho[]
  zonaCriticas      ZonaCriticaActiva[]
  mandados          Mandado[]
  ubicacionesActuales GuardiaUbicacionActual[]
  puntosFijos       PuntoFijo[]

  @@map("epi")
}

// Territorio versionado de cada EPI (0006). `epi.poligono` queda como la
// versión 1 legado; el código lee la versión `vigente` de esta tabla.
model EpiTerritorio {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  epiId      String   @map("epi_id") @db.Uuid
  version    Int
  poligono   Json
  origen     String
  aproximado Boolean  @default(true)
  vigente    Boolean  @default(false)
  notas      String?
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  epi Epi @relation(fields: [epiId], references: [id])

  @@unique([epiId, version])
  @@map("epi_territorio")
}

// Módulos policiales del inventario oficial (0006). Las coordenadas no son
// únicas: MP-511 y FELCV Uspha Uspha comparten punto.
model ModuloPolicial {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                 String   @unique
  nombre                 String
  epiId                  String   @map("epi_id") @db.Uuid
  direccion              String?
  zona                   String?
  lat                    Float
  lng                    Float
  coordenadasAproximadas Boolean  @default(false) @map("coordenadas_aproximadas")
  telefono               String?
  estado                 String?
  activo                 Boolean  @default(true)
  fuente                 String
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  epi Epi @relation(fields: [epiId], references: [id])

  @@map("modulo_policial")
}

model Role {
  id          String  @id @default(uuid())
  codigo      String  @unique
  nombre      String
  descripcion String?

  users            User[]
  rolePermissions  RolePermission[]

  @@map("role")
}

model RolePermission {
  id            String @id @default(uuid())
  roleId        String @map("role_id") @db.Uuid
  recurso       String
  puedeVer      Boolean @default(false) @map("puede_ver")
  puedeCrear    Boolean @default(false) @map("puede_crear")
  puedeEditar   Boolean @default(false) @map("puede_editar")
  puedeEliminar Boolean @default(false) @map("puede_eliminar")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, recurso])
  @@map("role_permission")
}

model TipoHecho {
  id     String  @id @default(uuid())
  codigo String  @unique
  label  String
  activo Boolean @default(true)
  orden  Int     @default(100)

  hechoes Hecho[]

  @@map("tipo_hecho")
}

// ------------------------------------------------------ 3. usuarios y sesión

model User {
  id                  String    @id @default(uuid())
  roleId              String    @map("role_id") @db.Uuid
  primerNombre        String    @map("primer_nombre")
  segundoNombre       String?   @map("segundo_nombre")
  apellidoPaterno     String    @map("apellido_paterno")
  apellidoMaterno     String    @map("apellido_materno")
  email               String    @unique
  usuario             String    @unique
  ci                  String?   @unique
  telefono            String?
  fechaNacimiento     DateTime? @map("fecha_nacimiento") @db.Date
  passwordHash        String    @map("password_hash")
  estado              user_estado @default(activo)
  debeCambiarPassword Boolean   @default(true) @map("debe_cambiar_password")
  creadoPorId         String?   @map("creado_por") @db.Uuid
  ultimoLogin         DateTime? @map("ultimo_login") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Jurisdicción (EPI) del Operador/Admin — restringe crear/asignar/cancelar
  // rutas a su EPI (mapas.service.ts). null en super_admin = sin restricción.
  epiId               String?   @map("epi_id") @db.Uuid

  role                Role              @relation(fields: [roleId], references: [id])
  epi                 Epi?              @relation(fields: [epiId], references: [id], onDelete: SetNull)
  creadoPor           User?             @relation("UserCreado", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creados             User[]            @relation("UserCreado")
  guardiasCreados     Guardia[]         @relation("GuardiaCreada")
  rutasCreadas        RutaPlantilla[]   @relation("RutaCreada")
  patrullasAsignadas  Patrulla[]        @relation("PatrullaAsignada")
  hechosEstado        Hecho[]           @relation("HechoEstado")
  sosAtendidos        GuardiaTelemetria[] @relation("SosAtendido")
  auditLogs           AuditLog[]        @relation("AuditActor")

  @@map("user")
}

model Guardia {
  id                  String                  @id @default(uuid())
  epiId               String?                 @map("epi_id") @db.Uuid
  primerNombre        String                  @map("primer_nombre")
  segundoNombre       String?                 @map("segundo_nombre")
  apellidoPaterno     String                  @map("apellido_paterno")
  apellidoMaterno     String                  @map("apellido_materno")
  ci                  String                  @unique
  usuario             String                  @unique
  passwordHash        String?                 @map("password_hash")
  telefono            String
  fotoUrl             String?                 @map("foto_url")
  fechaNacimiento     DateTime                @map("fecha_nacimiento") @db.Date
  estado              guardia_estado          @default(pendiente_activacion)
  estadoOperativo     guardia_estado_operativo @default(fuera_de_servicio) @map("estado_operativo")
  activacionToken     String?                 @map("activacion_token")
  activacionExpira    DateTime?               @map("activacion_expira") @db.Timestamptz(6)
  debeCambiarPassword Boolean                 @default(true) @map("debe_cambiar_password")
  creadoPorId         String                  @map("creado_por") @db.Uuid
  activadoEn          DateTime?               @map("activado_en") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)

  epi       Epi?    @relation(fields: [epiId], references: [id], onDelete: SetNull)
  creadoPor User    @relation("GuardiaCreada", fields: [creadoPorId], references: [id])
  turnos    Turno[]
  patrullas Patrulla[]
  hechoes   Hecho[]
  telemetrias GuardiaTelemetria[]
  mandados  Mandado[]
  checkpoints Checkpoint[]
  ubicacionActual GuardiaUbicacionActual?

  @@map("guardia")
}

model PasswordReset {
  id          String      @id @default(uuid())
  sujetoTipo  sujeto_auth @map("sujeto_tipo")
  sujetoId    String      @map("sujeto_id")
  codigoHash  String      @map("codigo_hash")
  expiraEn    DateTime    @map("expira_en") @db.Timestamptz(6)
  usado       Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset")
}

model RefreshToken {
  id               String      @id @default(uuid())
  sujetoTipo       sujeto_auth @map("sujeto_tipo")
  sujetoId         String      @map("sujeto_id")
  tokenHash        String      @unique @map("token_hash")
  familia          String
  expiraEn         DateTime    @map("expira_en") @db.Timestamptz(6)
  revocada         Boolean     @default(false)
  reemplazadaPorId String?     @map("reemplazada_por") @db.Uuid
  ip               String?     @db.Inet
  userAgent        String?     @map("user_agent")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt           DateTime?   @map("used_at") @db.Timestamptz(6)

  @@map("refresh_token")
}

// ------------------------------------------------------ 4. patrullaje

model RutaPlantilla {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  epiId       String?  @map("epi_id") @db.Uuid
  trazado     Json?
  activo      Boolean  @default(true)
  modalidad   String?  @map("modalidad")
  // F2 (0007): establecida | guardada | dinamica. duracionMin = cuánto dura
  // una asignación de esta ruta (null = sin límite, la cierra el usuario).
  tipo        String?
  duracionMin Int?     @map("duracion_min")
  capacidad   Int?     @db.SmallInt
  creadoPorId String?  @map("creado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  epi       Epi?      @relation(fields: [epiId], references: [id], onDelete: SetNull)
  creadoPor User?     @relation("RutaCreada", fields: [creadoPorId], references: [id], onDelete: SetNull)
  patrullas Patrulla[]
  ejecuciones RutaEjecucion[]

  @@map("ruta_plantilla")
}

// F2 (0007): una asignación concreta de una ruta. Agrupa a los guardias que
// la cumplen juntos; trazado copiado (snapshot) para que editar la plantilla
// no cambie lo ya asignado. fin null = sin límite (ruta dinámica).
model RutaEjecucion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rutaPlantillaId String?   @map("ruta_plantilla_id") @db.Uuid
  epiId           String?   @map("epi_id") @db.Uuid
  tipo            String
  nombre          String
  descripcion     String?
  modalidad       String
  capacidad       Int       @db.SmallInt
  trazado         Json?
  unidad          String?
  origen          String    @default("manual")
  estado          String    @default("activa")
  inicio          DateTime  @default(now()) @db.Timestamptz(6)
  fin             DateTime? @db.Timestamptz(6)
  motivoCierre    String?   @map("motivo_cierre")
  cerradaEn       DateTime? @map("cerrada_en") @db.Timestamptz(6)
  cerradaPorId    String?   @map("cerrada_por") @db.Uuid
  creadoPorId     String?   @map("creado_por") @db.Uuid
  creadoPorTipo   String    @default("user") @map("creado_por_tipo")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  // F4 (0009): asignación a un punto fijo (raíz) y copia del destino.
  puntoFijoId     String?   @map("punto_fijo_id") @db.Uuid
  destino         Json?

  // F5 (0010): horario programado del que salió (null = asignación manual).
  programacionId      String?   @map("programacion_id") @db.Uuid
  ventanaId           String?   @map("ventana_id") @db.Uuid
  fechaLocal          DateTime? @map("fecha_local") @db.Date
  programacionVersion Int?      @map("programacion_version")
  apertura            DateTime? @db.Timestamptz(6)
  // F6 (0011): copia del modo de asignación y estado de los intentos automáticos.
  asignacionModo      String?   @map("asignacion_modo")
  autoRadioM          Int?      @map("auto_radio_m")
  autoProximoIntento  DateTime? @map("auto_proximo_intento") @db.Timestamptz(6)
  autoIntentos        Int       @default(0) @map("auto_intentos")
  autoUltimo          Json?     @map("auto_ultimo")

  rutaPlantilla RutaPlantilla?           @relation(fields: [rutaPlantillaId], references: [id])
  puntoFijo     PuntoFijo?               @relation(fields: [puntoFijoId], references: [id])
  programacion  RutaProgramacion?        @relation(fields: [programacionId], references: [id])
  ventana       RutaProgramacionVentana? @relation(fields: [ventanaId], references: [id])
  patrullas     Patrulla[]
  intentosAuto  AsignacionAutomaticaIntento[]

  @@map("ruta_ejecucion")
}

// F5 (0010): qué se cubre (ruta de la biblioteca o punto fijo) y en qué
// vigencia. Sus ventanas dicen días, hora, duración y cupo.
model RutaProgramacion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  descripcion     String?
  epiId           String    @map("epi_id") @db.Uuid
  rutaPlantillaId String?   @map("ruta_plantilla_id") @db.Uuid
  puntoFijoId     String?   @map("punto_fijo_id") @db.Uuid
  modalidad       String
  vigenciaDesde   DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta   DateTime? @map("vigencia_hasta") @db.Date
  zonaHoraria     String    @default("America/La_Paz") @map("zona_horaria")
  modo            String    @default("manual")
  // F6 (0011): radio inicial de la búsqueda automática (lo fija el sistema).
  radioMaxM       Int?      @map("radio_max_m")
  estado          String    @default("activa")
  origen          String    @default("manual")
  version         Int       @default(1)
  creadoPorId     String?   @map("creado_por") @db.Uuid
  actualizadoPorId String?  @map("actualizado_por") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  ventanas    RutaProgramacionVentana[]
  ejecuciones RutaEjecucion[]

  @@map("ruta_programacion")
}

model RutaProgramacionVentana {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programacionId String   @map("programacion_id") @db.Uuid
  /// 1 = lunes … 7 = domingo (ISO).
  dias           Int[]    @db.SmallInt
  horaInicio     DateTime @map("hora_inicio") @db.Time(6)
  duracionMin    Int      @map("duracion_min")
  cupo           Int      @db.SmallInt
  orden          Int      @default(0) @db.SmallInt
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  programacion RutaProgramacion @relation(fields: [programacionId], references: [id])
  ejecuciones  RutaEjecucion[]

  @@map("ruta_programacion_ventana")
}

model PlanificadorEstado {
  id             Int       @id @db.SmallInt
  habilitado     Boolean   @default(true)
  ultimaPasada   DateTime? @map("ultima_pasada") @db.Timestamptz(6)
  ultimaPasadaOk DateTime? @map("ultima_pasada_ok") @db.Timestamptz(6)
  ultimoError    String?   @map("ultimo_error")
  cambiadoPorId  String?   @map("cambiado_por") @db.Uuid
  cambiadoEn     DateTime? @map("cambiado_en") @db.Timestamptz(6)
  motivo         String?

  @@map("planificador_estado")
}

model PlanificadorRegistro {
  id        BigInt   @id @default(autoincrement())
  inicio    DateTime @db.Timestamptz(6)
  fin       DateTime @db.Timestamptz(6)
  abiertas  Int      @default(0)
  iniciadas Int      @default(0)
  cerradas  Int      @default(0)
  perdidas  Int      @default(0)
  omitidas  Int      @default(0)
  errores   Int      @default(0)
  detalle   Json?

  @@map("planificador_registro")
}

// F6 (0011): intento de asignación automática (a quién eligió y a quién descartó, y por qué).
model AsignacionAutomaticaIntento {
  id          BigInt   @id @default(autoincrement())
  ejecucionId String   @map("ejecucion_id") @db.Uuid
  intento     Int
  ejecutadoEn DateTime @default(now()) @map("ejecutado_en") @db.Timestamptz(6)
  asignados   Int      @default(0)
  faltan      Int      @default(0)
  candidatos  Int      @default(0)
  radioM      Int?     @map("radio_m")
  elegidos    Json     @default("[]")
  excluidos   Json     @default("[]")
  error       String?

  ejecucion RutaEjecucion @relation(fields: [ejecucionId], references: [id])

  @@map("asignacion_automatica_intento")
}

// F2 (0007): resultado de una operación por su clave idempotente.
model OperacionIdempotente {
  clave     String   @id @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  operacion String
  huella    String
  resultado Json
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("operacion_idempotente")
}

model Patrulla {
  id                 String          @id @default(uuid())
  guardiaId          String          @map("guardia_id") @db.Uuid
  rutaPlantillaId    String?         @map("ruta_plantilla_id") @db.Uuid
  epiId              String?         @map("epi_id") @db.Uuid
  asignadoPorId      String          @map("asignado_por") @db.Uuid
  estado             patrulla_estado @default(asignada)
  fecha              DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  horaInicioPrevista DateTime?       @map("hora_inicio_prevista") @db.Time(6)
  notas              String?
  nombre             String?
  descripcion        String?
  poligonoGeojson    Json?           @map("poligono_geojson")
  turnoId            String?         @map("turno_id") @db.Uuid
  // F2 (0007)
  ejecucionId        String?         @map("ejecucion_id") @db.Uuid
  modalidad          String?
  motivoCierre       String?         @map("motivo_cierre")
  estadoRuta         String?         @map("estado_ruta")
  distanciaRutaM     Int?            @map("distancia_ruta_m")
  estadoRutaEn       DateTime?       @map("estado_ruta_en") @db.Timestamptz(6)
  incorporadaEn      DateTime?       @map("incorporada_en") @db.Timestamptz(6)
  // F7 (0012): hora límite para incorporarse; vencida sin llegar → advertencia/alerta.
  incorporacionLimite DateTime?      @map("incorporacion_limite") @db.Timestamptz(6)
  // F4 (0009): hoja (subpunto o punto sin subpuntos) donde está el guardia.
  puntoFijoId        String?         @map("punto_fijo_id") @db.Uuid
  iniciadaEn         DateTime?       @map("iniciada_en") @db.Timestamptz(6)
  completadaEn       DateTime?       @map("completada_en") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  guardia       Guardia       @relation(fields: [guardiaId], references: [id])
  rutaPlantilla RutaPlantilla? @relation(fields: [rutaPlantillaId], references: [id], onDelete: SetNull)
  epi           Epi?          @relation(fields: [epiId], references: [id], onDelete: SetNull)
  asignadoPor   User          @relation("PatrullaAsignada", fields: [asignadoPorId], references: [id])
  turno         Turno?        @relation("PatrullaTurno", fields: [turnoId], references: [id])
  turnosTurno   Turno[]       @relation("TurnoPatrullaRef")
  ejecucion     RutaEjecucion? @relation(fields: [ejecucionId], references: [id])
  puntoFijo     PuntoFijo?     @relation(fields: [puntoFijoId], references: [id])

  @@map("patrulla")
}

// F4 (0009): catálogo de puntos fijos (un nivel de subpuntos).
model PuntoFijo {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                 String   @unique
  padreId                String?  @map("padre_id") @db.Uuid
  nombre                 String
  descripcion            String?
  epiId                  String   @map("epi_id") @db.Uuid
  epiMetodo              String   @default("ubicacion") @map("epi_metodo")
  lat                    Float
  lng                    Float
  capacidad              Int      @db.SmallInt
  orden                  Int      @default(0) @db.SmallInt
  coordenadasAproximadas Boolean  @default(true) @map("coordenadas_aproximadas")
  origen                 String   @default("manual")
  activo                 Boolean  @default(true)
  version                Int      @default(1)
  creadoPorId            String?  @map("creado_por") @db.Uuid
  actualizadoPorId       String?  @map("actualizado_por") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  padre       PuntoFijo?         @relation("PuntoFijoSubpuntos", fields: [padreId], references: [id])
  subpuntos   PuntoFijo[]        @relation("PuntoFijoSubpuntos")
  epi         Epi                @relation(fields: [epiId], references: [id])
  versiones   PuntoFijoVersion[]
  ejecuciones RutaEjecucion[]
  patrullas   Patrulla[]

  @@map("punto_fijo")
}

model PuntoFijoVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  puntoFijoId   String   @map("punto_fijo_id") @db.Uuid
  version       Int
  cambio        String
  nombre        String
  epiId         String?  @map("epi_id") @db.Uuid
  lat           Float
  lng           Float
  capacidad     Int      @db.SmallInt
  activo        Boolean
  politica      String?
  afectados     Json?
  motivo        String?
  cambiadoPorId String?  @map("cambiado_por") @db.Uuid
  cambiadoEn    DateTime @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  puntoFijo PuntoFijo @relation(fields: [puntoFijoId], references: [id])

  @@unique([puntoFijoId, version])
  @@map("punto_fijo_version")
}

// ------------------------------------------------------ 5. operación en campo

model Turno {
  id               String       @id @default(uuid())
  guardiaId        String       @map("guardia_id") @db.Uuid
  patrullaId       String?      @map("patrulla_id") @db.Uuid
  estado           turno_estado @default(en_servicio)
  selfieInicioUrl  String       @map("selfie_inicio_url")
  latInicio        Float        @map("lat_inicio")
  lngInicio        Float        @map("lng_inicio")
  horainicio       DateTime     @map("hora_inicio") @db.Timestamptz(6)
  latFin           Float?       @map("lat_fin")
  lngFin           Float?       @map("lng_fin")
  horaFin          DateTime?    @map("hora_fin") @db.Timestamptz(6)
  distanciaMetros  Decimal      @default(0) @map("distancia_metros") @db.Decimal(12, 2)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  guardia     Guardia           @relation(fields: [guardiaId], references: [id])
  patrulla    Patrulla?         @relation("TurnoPatrullaRef", fields: [patrullaId], references: [id])
  patrullasEnTurno Patrulla[]   @relation("PatrullaTurno")
  telemetrias GuardiaTelemetria[]
  hechoes     Hecho[]
  mandados    Mandado[]
  checkpoints Checkpoint[]

  @@map("turno")
}

model GuardiaTelemetria {
  id                BigInt     @id @default(autoincrement()) @db.BigInt
  guardiaId         String     @map("guardia_id") @db.Uuid
  turnoId           String?    @map("turno_id") @db.Uuid
  lat               Float
  lng               Float
  precisionM        Decimal?   @map("precision_m") @db.Decimal(8, 2)
  velocidadMps      Decimal?   @map("velocidad_mps") @db.Decimal(8, 2)
  bateriaPct        Int?       @map("bateria_pct")
  esSos             Boolean    @default(false) @map("es_sos")
  sosEstado         String?    @map("sos_estado")
  sosAtendidoPorId  String?    @map("sos_atendido_por") @db.Uuid
  sosAtendidoEn     DateTime?  @map("sos_atendido_en") @db.Timestamptz(6)
  capturadoEn       DateTime   @map("capturado_en") @db.Timestamptz(6)
  recibidoEn        DateTime   @default(now()) @map("recibido_en") @db.Timestamptz(6)

  guardia       Guardia @relation(fields: [guardiaId], references: [id])
  turno         Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  sosAtendidoPor User?  @relation("SosAtendido", fields: [sosAtendidoPorId], references: [id], onDelete: SetNull)

  @@map("guardia_telemetria")
}

model Hecho {
  id                   String       @id @default(uuid())
  turnoId              String?      @map("turno_id") @db.Uuid
  guardiaId            String       @map("guardia_id") @db.Uuid
  tipoHechoId          String       @map("tipo_hecho_id") @db.Uuid
  descripcion          String
  nivelRiesgo          nivel_riesgo @map("nivel_riesgo")
  lat                  Float
  lng                  Float
  epiId                String?      @map("epi_id") @db.Uuid
  direccion            String?
  ocurridoEn           DateTime     @map("ocurrido_en") @db.Timestamptz(6)
  reportadoEn          DateTime     @default(now()) @map("reportado_en") @db.Timestamptz(6)
  estado               hecho_estado @default(reportado)
  estadoCambiadoPorId  String?      @map("estado_cambiado_por") @db.Uuid
  estadoCambiadoEn     DateTime?    @map("estado_cambiado_en") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  // F3 (0008): EPI del hecho por SU ubicación. metodo: ubicacion | manual |
  // legado; estado: asignada | ambigua | fuera_cobertura (pendiente de revisión).
  epiMetodo            String?      @map("epi_metodo")
  epiEstado            String?      @map("epi_estado")
  epiTerritorioVersion Int?         @map("epi_territorio_version")
  epiClasificadoEn     DateTime?    @map("epi_clasificado_en") @db.Timestamptz(6)

  turno             Turno?      @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  guardia           Guardia     @relation(fields: [guardiaId], references: [id])
  tipoHecho         TipoHecho   @relation(fields: [tipoHechoId], references: [id])
  epi               Epi?        @relation(fields: [epiId], references: [id], onDelete: SetNull)
  estadoCambiadoPor User?       @relation("HechoEstado", fields: [estadoCambiadoPorId], references: [id], onDelete: SetNull)
  evidencias        HechoEvidencia[]

  @@map("hecho")
}

model HechoEvidencia {
  id        String        @id @default(uuid())
  hechoId   String        @map("hecho_id") @db.Uuid
  url       String
  tipo      evidencia_tipo @default(foto)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  hecho Hecho @relation(fields: [hechoId], references: [id], onDelete: Cascade)

  @@map("hecho_evidencia")
}

model Mandado {
  id          String   @id @default(uuid())
  turnoId     String   @map("turno_id") @db.Uuid
  guardiaId   String   @map("guardia_id") @db.Uuid
  descripcion String
  lat         Float
  lng         Float
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  // F3 (0008): EPI del mandado por su ubicación (igual que hecho).
  epiId                String?   @map("epi_id") @db.Uuid
  epiMetodo            String?   @map("epi_metodo")
  epiEstado            String?   @map("epi_estado")
  epiTerritorioVersion Int?      @map("epi_territorio_version")
  epiClasificadoEn     DateTime? @map("epi_clasificado_en") @db.Timestamptz(6)

  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  guardia Guardia @relation(fields: [guardiaId], references: [id])
  epi     Epi?    @relation(fields: [epiId], references: [id])

  @@map("mandado")
}

// F3 (0008): última posición válida del guardia y la EPI en la que está.
// Una fila por guardia (no se escribe `guardia` en cada GPS). La EPI de la
// cuenta del guardia (guardia.epi_id) queda como dato legado.
model GuardiaUbicacionActual {
  guardiaId         String   @id @map("guardia_id") @db.Uuid
  telemetriaId      BigInt?  @map("telemetria_id")
  lat               Float
  lng               Float
  precisionM        Decimal? @map("precision_m") @db.Decimal(8, 2)
  bateriaPct        Int?     @map("bateria_pct")
  capturadoEn       DateTime @map("capturado_en") @db.Timestamptz(6)
  recibidoEn        DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)
  epiId             String?  @map("epi_id") @db.Uuid
  epiEstado         String   @map("epi_estado")
  territorioVersion Int?     @map("territorio_version")
  epiDesde          DateTime @default(now()) @map("epi_desde") @db.Timestamptz(6)
  actualizadoEn     DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  guardia Guardia @relation(fields: [guardiaId], references: [id], onDelete: Cascade)
  epi     Epi?    @relation(fields: [epiId], references: [id])

  @@map("guardia_ubicacion_actual")
}

// Verificación periódica de ronda (selfie + GPS) durante el turno — NO es lo
// mismo que `guardia_telemetria` (GPS continuo cada ~15s/25m): el checkpoint
// es una confirmación deliberada de presencia/identidad cada 30 minutos
// (`CHECKPOINT_INTERVALO_MS` en la app), con foto. `estado='perdido'` queda
// reservado para cuando la app decida reportar que el guardia no respondió
// a tiempo (hoy no lo hace — solo lo marca en memoria local); por eso
// `fotoUrl`/`lat`/`lng` son opcionales.
model Checkpoint {
  id          String            @id @default(uuid())
  turnoId     String            @map("turno_id") @db.Uuid
  guardiaId   String            @map("guardia_id") @db.Uuid
  estado      checkpoint_estado @default(realizado)
  fotoUrl     String?           @map("foto_url")
  lat         Float?
  lng         Float?
  capturadoEn DateTime          @map("capturado_en") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  guardia Guardia @relation(fields: [guardiaId], references: [id])

  @@index([turnoId])
  @@index([guardiaId, capturadoEn(sort: Desc)])
  @@map("checkpoint")
}

// ------------------------------------------------------ 6. derivados / auditoría

model ZonaCriticaActiva {
  id             String       @id @default(uuid())
  epiId          String?      @map("epi_id") @db.Uuid
  centroLat      Float        @map("centro_lat")
  centroLng      Float        @map("centro_lng")
  radioM         Decimal?     @map("radio_m") @db.Decimal(10, 2)
  poligono       Json?
  direccion      String?
  cantidadHechos Int          @map("cantidad_hechos")
  nivelRiesgo    nivel_riesgo @map("nivel_riesgo")
  ventanaDesde   DateTime     @map("ventana_desde") @db.Timestamptz(6)
  ventanaHasta   DateTime     @map("ventana_hasta") @db.Timestamptz(6)
  vigente        Boolean      @default(true)
  calculadaEn    DateTime     @default(now()) @map("calculada_en") @db.Timestamptz(6)

  epi Epi? @relation(fields: [epiId], references: [id], onDelete: SetNull)

  @@map("zona_critica_activa")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorTipo   String   @default("user") @map("actor_tipo")
  accion      String
  recurso     String?
  recursoId   String?  @map("recurso_id")
  detalle     Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}